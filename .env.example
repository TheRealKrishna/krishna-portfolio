# SMTP credentials for the contact form (server-side only — never exposed to the client).
# The contact form gracefully no-ops if these are unset, so the site still builds and runs.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
CONTACT_RECEIVING_EMAIL=

# Public site URL, used for canonical/OG/sitemap. Defaults to https://krishna.lol when unset.
NEXT_PUBLIC_SITE_URL=https://krishna.lol

# Google reCAPTCHA v3 — bot protection for the contact form.
# Leave unset to disable verification (the form still works in dev).
# Site key is public (exposed to the browser); secret key stays server-side.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
